# Copy this file to .env and fill in your values.
# Leave GEMINI_API_KEY empty to run with the built-in mock AI (no calls to Gemini).
GEMINI_API_KEY=

# true = start with Demo Mode on (cached sample articles instead of live RSS feeds)
DEMO_MODE=true

# true = use the mock AI even when a Gemini key is set
MOCK_AI=false
